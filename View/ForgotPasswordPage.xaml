<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:lms.android.ViewModel"
             x:Class="lms.android.View.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top header with back button -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource PrimaryDark}"
              Padding="7,10,7,17"
              ColumnDefinitions="Auto, *">

            <ImageButton Grid.Column="0"
                         Source="arrow_back.png"
                         Command="{Binding BackCommand}"
                         WidthRequest="24"
                         HeightRequest="24"
                         BackgroundColor="Transparent" />

            <Label Grid.Column="1"
                   Text="Account Recovery"
                   TextColor="White"
                   FontFamily="OpenSansSemibold"
                   FontSize="34"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,10,24,10" />
        </Grid>

        <!-- Main form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20" Margin="0,60,0,0">

                <Label Text="🔒" FontSize="74" HorizontalOptions="Center" Margin="0,0,0,8" />

                <Label Text="Forgot Password?"
                       Style="{StaticResource LargeLabel}"
                       FontSize="36"
                       HorizontalOptions="Center" />

                <Label Text="Enter your registered account email address below. We will generate a 6-digit verification code to reset your password."
                       Style="{StaticResource MediumLabel}"
                       HorizontalTextAlignment="Center"
                       FontSize="20"
                       LineHeight="1.2"
                       Opacity="0.85" />

                <Entry Placeholder="Email Address"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       Margin="0,20,0,0"
                       FontSize="28"
                       HeightRequest="52" />

                <!-- Main action: orange with navy text -->
                <Button Text="Send Verification Code"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding SendOtpCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        FontSize="28"
                        HeightRequest="60"/>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom link -->
        <Button Grid.Row="2"
                Text="Back to Login"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource PrimaryLight}}"
                FontSize="26"
                Command="{Binding BackCommand}"
                HorizontalOptions="Center"
                Margin="0,0,0,20" 
                HeightRequest="80"/>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:lms.android.ViewModel"
             x:Class="lms.android.View.ResetPasswordPage"
             x:DataType="vm:ResetPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Title="Reset Password">

    <Grid RowDefinitions="Auto, *">

        <!-- Top header: navy band, white title -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{StaticResource PrimaryDark}"
                             Padding="7,10,7,7">
            <Label Text="NEW CREDENTIALS"
                   Margin="0,10,0,10"
                   TextColor="White"
                   FontFamily="OpenSansSemibold"
                   FontSize="32"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Main form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="24" Margin="0,40,0,0">

                <Label Text="Reset Password"
                       Style="{StaticResource LargeLabel}"
                       FontSize="38"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <Entry Placeholder="6-digit code" Keyboard="Numeric" MaxLength="6" FontSize="28" Text="{Binding Code}" />
                <Entry Placeholder="New Password" IsPassword="True" FontSize="28" Text="{Binding NewPassword}" />
                <Entry Placeholder="Confirm New Password" IsPassword="True" FontSize="28" Text="{Binding ConfirmPassword}" />

                <!-- Main action: orange with navy text -->
                <Button Text="Reset Password"
                        Style="{StaticResource AccentButton}"
                        FontSize="30"
                        HeightRequest="60"
                        Command="{Binding ResetCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
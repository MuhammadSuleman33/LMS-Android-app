<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:lms.android.Model"
             xmlns:viewmodel="clr-namespace:lms.android.ViewModel"
             x:DataType="viewmodel:LMSViewModel"
             Title="{Binding Title}"
             x:Class="lms.android.View.MainPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding GetCourseCommand}" />
    </ContentPage.ToolbarItems>

    <Grid ColumnDefinitions="*,*"
          ColumnSpacing="5"
          RowDefinitions="*,Auto"
          RowSpacing="0">

        <RefreshView Grid.ColumnSpan="2"
                     Command="{Binding GetCourseCommand}"
                     IsRefreshing="{Binding IsRefreshing}">

            <CollectionView BackgroundColor="Transparent"
                            ItemsSource="{Binding Course}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No courses available."
                               Style="{StaticResource MediumLabel}"
                               Opacity="0.7" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Course">
                        <Grid Padding="10,6">
                            <Border Style="{StaticResource CardView}"
                                    HeightRequest="125">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:LMSViewModel}}, Path=GoToDetailsCommand}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="125,*">
                                    <Image Aspect="AspectFill"
                                           Source="{Binding ImageUrl}"
                                           WidthRequest="125"
                                           HeightRequest="125" />

                                    <VerticalStackLayout Grid.Column="1"
                                                         Padding="12"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource MediumLabel}"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                                        <Label Text="{Binding Description}"
                                               Style="{StaticResource SmallLabel}"
                                               MaxLines="3"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Bottom action buttons -->
     <!--   <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*, *" Margin="8" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Get Course"
                    Style="{StaticResource AccentButton}"
                    FontSize="18"
                    Command="{Binding GetCourseCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Grid.Column="1"
                    Text="Profile"
                    Style="{StaticResource ButtonOutline}"
                    HeightRequest="48"
                    CornerRadius="10"
                    FontSize="18"
                    Command="{Binding NavigateToProfileCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
        </Grid>

        -->
        
        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Grid.RowSpan="2"
                           Grid.ColumnSpan="2" />
    </Grid>
</ContentPage>
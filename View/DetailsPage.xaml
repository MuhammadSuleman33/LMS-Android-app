<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lms.android.View.DetailsPage"
             xmlns:viewmodel="clr-namespace:lms.android.ViewModel"
             x:DataType="viewmodel:LMSDetailsViewModel"
             Title="{Binding SelectedCourse.Name}">

    <ScrollView>
        <VerticalStackLayout>

            <!-- Header: colored band with the image centered in a circle -->
            <Grid>
                <BoxView HeightRequest="100"
                         VerticalOptions="Start"
                         Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />

                <Border WidthRequest="160"
                        HeightRequest="160"
                        Margin="0,30,0,0"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Stroke="{AppThemeBinding Light=White, Dark={StaticResource DarkBackground}}"
                        StrokeThickness="4"
                        StrokeShape="Ellipse">
                    <Image Aspect="AspectFill"
                           Source="{Binding SelectedCourse.ImageUrl}" />
                </Border>
            </Grid>

            <VerticalStackLayout Padding="15" Spacing="12">

                <!-- Course name -->
                <Label Text="{Binding SelectedCourse.Name}"
                       Style="{StaticResource LargeLabel}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Details card -->
                <Border Style="{StaticResource CardView}" Padding="15">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="About this course"
                               Style="{StaticResource MediumLabel}"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Primary}" />

                        <Label Text="{Binding SelectedCourse.Description}"
                               Style="{StaticResource MediumLabel}" />

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Card Border}, Dark={StaticResource PrimaryDark}}" />

                        <Label Text="{Binding SelectedCourse.CreditHours, StringFormat='Credit Hours: {0}'}"
                               Style="{StaticResource MediumLabel}" />

                        <Label Text="{Binding SelectedCourse.TeacherName, StringFormat='Teacher: {0}'}"
                               Style="{StaticResource MediumLabel}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Main action: one orange button per screen -->
                <Button Text="Continue Learning"
                        Style="{StaticResource AccentButton}"
                        Margin="0,5,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>